# ============================================================
# Top-level .env.example
# Copy thành `.env` ở root nếu cần override cho docker-compose.
# Backend & Frontend có .env riêng — xem backend/.env.example và frontend/.env.example.
# ============================================================

# Compose project name
COMPOSE_PROJECT_NAME=vn-legal-rag

# Public domain (Phase 12 deploy)
DOMAIN=localhost

# Image tag
TAG=dev
