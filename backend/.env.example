# ============================================================
# Backend environment variables — TEMPLATE
# Copy to backend/.env và điền giá trị thật. KHÔNG commit backend/.env
# ============================================================

# ----- App -----
APP_ENV=dev                      # dev | prod
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR

# ----- LLM provider -----
# Provider chính (openrouter | gemini | deepseek | custom)
# - custom = bất kỳ endpoint OpenAI-compatible (vd local proxy như 9router/LiteLLM/Ollama)
LLM_PROVIDER=openrouter
LLM_MODEL=google/gemini-2.5-flash       # ID model theo convention của provider

# Per-provider keys (set của cái nào bạn dùng; rotate ngay nếu lộ!)
GEMINI_API_KEY=
GEMINI_API_KEY_BACKUP=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

# Custom OpenAI-compatible endpoint (khi LLM_PROVIDER=custom)
# Trong Docker container, "localhost" ≠ host máy. Nếu LLM gateway chạy trên VPS host:
#   - Linux: dùng http://host.docker.internal:PORT/v1
#     (cần `extra_hosts: ["host.docker.internal:host-gateway"]` trong docker-compose)
#   - Hoặc dùng IP/hostname VPS thật.
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=                        # default = giá trị LLM_MODEL ở trên nếu trống

# ----- Embedding -----
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu             # cpu | cuda

# ----- Vector store -----
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION=legal_vn

# ----- Redis -----
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_LLM_CACHE=86400        # 24h
REDIS_TTL_QUERY_EMBED=604800     # 7 days
REDIS_TTL_SESSION=3600           # 1h

# ----- Auth -----
# JWT — PHẢI giống NEXTAUTH_SECRET ở frontend
JWT_SECRET=change-me-random-32-chars-min
JWT_ALGORITHM=HS256

# API keys (comma-separated) cho admin/script path
ALLOWED_API_KEYS=

# ----- Rate limit -----
RATE_LIMIT_PER_MINUTE=30

# ----- Retrieval -----
TOP_K_DENSE=30
TOP_K_BM25=30
TOP_K_FINAL=10
ENABLE_RERANK=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ----- CORS (comma-separated origins) -----
CORS_ORIGINS=http://localhost:3000
