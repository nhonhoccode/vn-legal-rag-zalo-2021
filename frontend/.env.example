# ============================================================
# Frontend environment — TEMPLATE
# Copy thành frontend/.env.local. KHÔNG commit .env.local
# ============================================================

# ----- Backend API endpoint -----
NEXT_PUBLIC_API_URL=http://localhost:8000

# Service API key gọi backend (pick 1 từ ALLOWED_API_KEYS ở backend/.env)
# Pattern: server-side proxy — frontend dùng key này để gọi backend, KHÔNG expose ra browser.
BACKEND_API_KEY=

# ----- NextAuth (PHẢI giống JWT_SECRET ở backend) -----
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ----- OAuth providers -----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
